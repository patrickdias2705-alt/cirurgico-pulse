# Server-only PostgreSQL DSN for wf_dashboard_ro (SELECT only).
ANALYTICS_DATABASE_URL=postgresql://wf_dashboard_ro:CHANGE_ME@HOST:5432/postgres?sslmode=require

# Server-only DSN for a role allowed to write only analytics snapshot tables.
