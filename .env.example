ANALYTICS_MEMBER_ID=replace-with-bitrix-member-id
ANALYTICS_SYNC_SECRET=generate-a-long-random-secret
WF_AUTH_BASE_URL=https://your-whatsapp-wf.example.com
BITRIX_DOMAIN=b24-hybg84.bitrix24.com.br
ANALYTICS_SYNC_STALE_MINUTES=10
